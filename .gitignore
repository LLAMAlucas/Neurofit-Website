node_modules
dist
dist-ssr

# Secrets. `.env*` is deliberately broad and matches at every depth: the root
# .env.local holds a live GEMINI_API_KEY, and site/.env.local holds a Vercel
# OIDC token. Neither may ever enter this repo.
.env
.env.*
*.local
!.env.example

# Vercel CLI local state (project/org ids, pulled env)
.vercel

# Vite rewrites this next to the config on every dev start
vite.config.ts.timestamp-*.mjs

# Build info
*.tsbuildinfo

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.vercel
.env*
