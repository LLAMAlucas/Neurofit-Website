# Neuro-Fit environment.
# Copy to .env.local (gitignored) and fill in to enable the AI coaching cues.
# Without a key the app runs fully — only the AI coach panel is disabled.

# Gemini API key (https://aistudio.google.com/apikey). Browser-direct for this
# prototype; a key-holding proxy is the production path.
GEMINI_API_KEY=your_key_here

# Optional model override. Default: gemini-3.5-flash.
# Other good options: gemini-2.5-flash-lite (fastest/cheapest), gemini-2.5-flash.
GEMINI_MODEL=gemini-3.5-flash
